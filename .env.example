GEMINI_API_KEY=
MONGODB_URI=             # Atlas connection string mongodb+srv://...
MONGODB_DB_NAME=progsu_intelligence
MONGODB_COLLECTION=chunks
GOOGLE_DRIVE_CREDENTIALS=./service_account.json
GOOGLE_CALENDAR_ID=primary   # or your specific calendar ID from Google Calendar settings
GMAIL_DEMO_RECIPIENT=        # email address for PLAN mode Gmail draft recipient
API_PORT=8000
API_HOST=0.0.0.0

# --- Public demo safety settings (set these in Cloud Run / production) ---
# DEMO_MODE=true            # enables per-IP rate limiting, query length cap, injection blocking
# DAILY_REQUEST_CAP=300     # hard daily cap across all IPs; 0 to disable
# ALLOWED_ORIGINS=https://your-frontend.vercel.app  # comma-separated; * for local dev
# ADMIN_TOKEN=              # shared secret for X-Admin-Token header on /cache/clear

# --- Discord OAuth tiered access (all five required vars set = auth on; ---
# --- any missing = legacy DEMO_MODE behavior, no login)                 ---
# DISCORD_CLIENT_ID=        # OAuth app (Discord developer portal)
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=        # bot must be in the server with members intent enabled
# DISCORD_GUILD_ID=         # the progsu server id
# SESSION_SECRET=           # long random string; HMAC key for bearer tokens
# DISCORD_EXEC_ROLE_IDS=    # comma-separated role ids mapped to exec tier
# DISCORD_ADMIN_ROLE_IDS=   # comma-separated role ids mapped to admin tier
# DISCORD_ADMIN_USER_IDS=   # comma-separated user ids always admin (bootstrap)
# DISCORD_REDIRECT_URI=     # defaults to <backend>/auth/callback
# FRONTEND_URL=             # where /auth/callback redirects with the token
# DISCORD_SYNC_WEBHOOK_URL=  # optional: post one-line sync summaries to a Discord channel
