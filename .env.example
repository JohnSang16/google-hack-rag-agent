# Copy this file to .env and fill in your values
# NEVER commit .env — it is gitignored

# Gemini / Google AI
GEMINI_API_KEY=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=progsu_intelligence
MONGODB_COLLECTION=chunks

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=us-central1
GOOGLE_DRIVE_CREDENTIALS=./service_account.json

# Google Drive (output folder for PLAN mode created docs)
DRIVE_OUTPUT_FOLDER_ID=11eYr6RIieuw4EvCZCzaMBa8ib8llDr9-

# API Server
API_PORT=8000
API_HOST=0.0.0.0
